    "./pl-feedback": "./Library/components/app/surfaces/pl-feedback/index.mjs",
    "./pl-footer": "./Library/components/content/structure/pl-footer/index.mjs",
    "./pl-form": "./Library/components/app/inputs/pl-form/index.mjs",
    "./pl-header": "./Library/components/content/structure/pl-header/index.mjs",
    "./pl-hero": "./Library/components/content/sections/pl-hero/index.mjs",
    "./pl-icon": "./Library/components/app/ui/pl-icon/index.mjs",
    "./pl-input": "./Library/components/app/inputs/pl-input/index.mjs",
