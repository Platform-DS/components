    "./pl-textarea": "./Library/components/app/inputs/pl-textarea/index.mjs",
    "./pl-ui-kit-page": "./Library/components/content/pages/pl-ui-kit-page/index.mjs",
    "./pl-video": "./Library/components/app/media/pl-video/index.mjs",
    "./*": "./Library/components/*/index.mjs"
