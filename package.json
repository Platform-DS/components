{
  "name": "@platformdesign/components",
  "version": "0.1.1",
  "description": "Native web components. No build step, no framework, no dependencies — just the browser.",
  "license": "MIT",
  "author": "Platform Design",
  "type": "module",
  "sideEffects": [
    "./Library/index.mjs",
    "./Library/components/**/index.mjs"
  ],
  "files": [
    "Library",
    "README.md"
  ],
  "keywords": [
    "web-components",
    "custom-elements",
    "shadow-dom",
    "design-system",
    "no-build",
    "vanilla"
  ],
  "exports": {
    ".": "./Library/index.mjs",
    "./tokens.css": "./Library/_core/styles/tokens.css",
    "./_core/*": "./Library/_core/*",
    "./utilities/*": "./Library/utilities/*",
    "./pl-accordion": "./Library/components/app/surfaces/pl-accordion/index.mjs",
    "./pl-accordion-group": "./Library/components/app/surfaces/pl-accordion-group/index.mjs",
    "./pl-autocomplete": "./Library/components/app/inputs/pl-autocomplete/index.mjs",
    "./pl-avatar": "./Library/components/app/ui/pl-avatar/index.mjs",
    "./pl-badge": "./Library/components/app/ui/pl-badge/index.mjs",
    "./pl-benefits": "./Library/components/content/sections/pl-benefits/index.mjs",
    "./pl-button": "./Library/components/app/inputs/pl-button/index.mjs",
    "./pl-button-group": "./Library/components/app/inputs/pl-button-group/index.mjs",
    "./pl-button-link": "./Library/components/app/inputs/pl-button-link/index.mjs",
    "./pl-carousel": "./Library/components/app/surfaces/pl-carousel/index.mjs",
    "./pl-checkbox": "./Library/components/app/inputs/pl-checkbox/index.mjs",
    "./pl-chip": "./Library/components/app/ui/pl-chip/index.mjs",
    "./pl-code-block": "./Library/components/app/surfaces/pl-code-block/index.mjs",
    "./pl-color-picker": "./Library/components/app/inputs/pl-color-picker/index.mjs",
    "./pl-cta": "./Library/components/content/sections/pl-cta/index.mjs",
    "./pl-dialog": "./Library/components/app/surfaces/pl-dialog/index.mjs",
    "./pl-faqs": "./Library/components/content/sections/pl-faqs/index.mjs",
    "./pl-features": "./Library/components/content/sections/pl-features/index.mjs",
    "./pl-feedback": "./Library/components/app/surfaces/pl-feedback/index.mjs",
    "./pl-footer": "./Library/components/content/structure/pl-footer/index.mjs",
    "./pl-form": "./Library/components/app/inputs/pl-form/index.mjs",
    "./pl-header": "./Library/components/content/structure/pl-header/index.mjs",
    "./pl-hero": "./Library/components/content/sections/pl-hero/index.mjs",
    "./pl-icon": "./Library/components/app/ui/pl-icon/index.mjs",
    "./pl-input": "./Library/components/app/inputs/pl-input/index.mjs",
    "./pl-label": "./Library/components/app/inputs/pl-label/index.mjs",
    "./pl-popover": "./Library/components/app/surfaces/pl-popover/index.mjs",
    "./pl-product-card": "./Library/components/app/surfaces/pl-product-card/index.mjs",
    "./pl-profile-card": "./Library/components/app/surfaces/pl-profile-card/index.mjs",
    "./pl-radio": "./Library/components/app/inputs/pl-radio/index.mjs",
    "./pl-radio-group": "./Library/components/app/inputs/pl-radio-group/index.mjs",
    "./pl-range": "./Library/components/app/inputs/pl-range/index.mjs",
    "./pl-ratings": "./Library/components/app/inputs/pl-ratings/index.mjs",
    "./pl-search": "./Library/components/app/inputs/pl-search/index.mjs",
    "./pl-select": "./Library/components/app/inputs/pl-select/index.mjs",
    "./pl-social-proof": "./Library/components/content/sections/pl-social-proof/index.mjs",
    "./pl-switch": "./Library/components/app/inputs/pl-switch/index.mjs",
    "./pl-testimonials": "./Library/components/content/sections/pl-testimonials/index.mjs",
    "./pl-textarea": "./Library/components/app/inputs/pl-textarea/index.mjs",
    "./*": "./Library/components/*/index.mjs"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "exports": "node scripts/generate-exports.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "publishConfig": {
    "access": "public"
  }
}
