  "scripts": {
    "dev": "node scripts/serve.mjs",
    "exports": "node scripts/generate-exports.mjs",
    "release": "node scripts/release.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "build": "node scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
