{
  "name": "@platformdesign/components",
  "version": "0.3.1",
  "description": "Native web components. No build step, no framework, no dependencies — just the browser.",
  "license": "MIT",
  "author": "Platform Design",
  "type": "module",
  "sideEffects": [
    "./Library/index.mjs",
    "./Library/components/**/index.mjs"
  ],
  "files": [
    "Library",
    "dist",
    "README.md"
  ],
  "keywords": [
    "web-components",
    "custom-elements",
    "shadow-dom",
    "design-system",
    "no-build",
    "vanilla"
  ],
  "exports": {
    ".": "./Library/index.mjs",
    "./tokens.css": "./Library/_core/styles/tokens.css",
    "./global.css": "./Library/_core/styles/global.css",
    "./_core/*": "./Library/_core/*",
    "./utilities/*": "./Library/utilities/*",
    "./min": "./dist/platform.js",
    "./min/*": "./dist/*.js",
    "./min/tokens.css": "./dist/tokens.css",
    "./min/global.css": "./dist/global.css",
    "./pl-accordion": "./Library/components/app/surfaces/pl-accordion/index.mjs",
    "./pl-accordion-group": "./Library/components/app/surfaces/pl-accordion-group/index.mjs",
    "./pl-app-navigation": "./Library/components/app/navigation/pl-app-navigation/index.mjs",
